# ─────────────────────────────────────────────────────────────────────────────
# Registrar Desk — BACKEND environment (BUILD_SPEC §8.1)
# Copy to backend/.env and fill in. backend/.env is git-ignored and is the ONLY
# place secrets live. Never put any of these in the frontend.
# ─────────────────────────────────────────────────────────────────────────────

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4848
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# [INPUT REQUIRED] MongoDB Atlas connection string.
# Atlas → your cluster → Connect → Drivers. Include the database name after the host, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/registrar-desk?retryWrites=true&w=majority
# Also add your machine's IP (or 0.0.0.0/0 for dev only) under Atlas → Network Access.
MONGODB_URI=

# --- URLs ------------------------------------------------------------------
# Public base URL of this API (logs, and inline-image links in imported email). Production: the
# App Service address, e.g. https://<web-app-name>.azurewebsites.net. Production settings: .env.production.example
APP_BASE_URL=http://localhost:4848
# The web app's URL(s), comma-separated — the only origins allowed by CORS and the live connection.
# In production: the Vercel address(es), e.g. https://desk.example.com,https://desk-preview.example.com
FRONTEND_ORIGIN=http://localhost:3000

# --- Microsoft Entra ID / Graph (needed from Phase 1 / Phase 2) ------------
# [INPUT REQUIRED] Azure Portal → Microsoft Entra ID → Overview → Tenant ID
AZURE_TENANT_ID=
# [INPUT REQUIRED] Azure Portal → App registrations → <your app> → Application (client) ID
AZURE_CLIENT_ID=
# Audience of staff sign-in tokens — the "Application ID URI" under Expose an API.
# Leave empty to use the default api://<AZURE_CLIENT_ID>.
AZURE_API_AUDIENCE=
# [INPUT REQUIRED — Phase 2] App registration → Certificates & secrets → New client secret (copy the VALUE)
AZURE_CLIENT_SECRET=
# [INPUT REQUIRED — Phase 2] The shared mailbox to monitor and send from, e.g. enquiries@yourdomain.com
# Check it with: npm run graph:check
GRAPH_SHARED_MAILBOX=
# OPTIONAL — push notifications. Public HTTPS URL that Graph calls, ending in /api/graph/webhook,
# e.g. https://<your-tunnel>.ngrok-free.app/api/graph/webhook (a tunnel to port 4848 in development).
# Leave empty to rely on polling only; set it (plus GRAPH_WEBHOOK_SECRET) for near-instant delivery.
GRAPH_WEBHOOK_URL=

# --- Mailbox sync -----------------------------------------------------------
# How often to check the Inbox for new mail, in seconds (15–3600). Polling also backs up push.
GRAPH_POLL_INTERVAL_SECONDS=60
# On the very first sync, import Inbox mail from the last N days (older mail is left alone).
GRAPH_INITIAL_SYNC_DAYS=2
# Set to false on extra machines that share the same database, so only one copy syncs the mailbox.
GRAPH_SYNC_ENABLED=true
# --- Sending (Phase 3) ------------------------------------------------------
# Safety net for outgoing mail. When set, the app ONLY sends to these addresses (comma-separated)
# and refuses everything else. Outside production, leaving it empty means NO email is sent at all.
# Leave empty in production to allow replies to any shareholder.
MAIL_SEND_ALLOWLIST=

# Where email attachments are kept:
#   mailbox  — not copied; fetched from the shared mailbox when an officer opens one. Uses almost no
#              database space (right for a free Atlas tier). If the email is deleted from the mailbox,
#              its attachments can no longer be opened.
#   database — full copies in MongoDB GridFS, independent of the mailbox (needs a paid tier).
ATTACHMENT_STORAGE=mailbox

# --- Generated secrets -----------------------------------------------------
# Generate each with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Validates that Graph change notifications really came from our subscription (16+ characters).
GRAPH_WEBHOOK_SECRET=
# [REQUIRED] Signs the app's own session cookie (min 32 characters).
JWT_SECRET=

# --- Sign-in & roles -------------------------------------------------------
# Session length in hours before staff must sign in again.
SESSION_TTL_HOURS=10
# Comma-separated staff emails that become admins on first sign-in (bootstraps the first admin;
# afterwards roles are managed in Admin → Users).
BOOTSTRAP_ADMIN_EMAILS=
# Local development only: shows a "Developer sign-in" form so you can sign in as any user/role
# without Microsoft. The server refuses to start with this on when NODE_ENV=production.
AUTH_DEV_LOGIN=false
