# ─────────────────────────────────────────────────────────────────────────────
# Registrar Desk — PRODUCTION settings for Azure App Service (see DEPLOYMENT.md)
# Copy to backend/.env.production.local (git-ignored), fill in, then run
#   APP=<web-app-name> bash scripts/azure-provision.sh
# which loads every non-empty line as an App Service setting. NODE_ENV=production and
# TZ=Africa/Lagos are added by the script. Never commit the filled-in copy.
# ─────────────────────────────────────────────────────────────────────────────

# A production database — not the development one. A free Atlas tier (M0, in its own Atlas project)
# is fine for a proof of concept with ATTACHMENT_STORAGE=mailbox; see DEPLOYMENT.md §2.
MONGODB_URI=

# Public HTTPS address of this API (the App Service URL or its custom domain), no trailing slash.
APP_BASE_URL=https://<web-app-name>.azurewebsites.net
# The web app's address(es) on Vercel, comma-separated. Only these may call the API.
FRONTEND_ORIGIN=https://<project>.vercel.app

# New random values — don't reuse development secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
GRAPH_WEBHOOK_SECRET=

# Microsoft Entra ID / Graph (same app registration as development, or a production one).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_API_AUDIENCE=
AZURE_CLIENT_SECRET=
GRAPH_SHARED_MAILBOX=
# Push notifications for near-instant mail: this API's public webhook address.
GRAPH_WEBHOOK_URL=https://<web-app-name>.azurewebsites.net/api/graph/webhook

# Empty in production = replies can go to any shareholder.
MAIL_SEND_ALLOWLIST=
# mailbox  = attachments opened from the shared mailbox; almost no database space (right for a free
#            Atlas tier). They can't be opened once their email is deleted from the mailbox.
# database = full copies in MongoDB, independent of the mailbox; use on a paid Atlas tier.
ATTACHMENT_STORAGE=mailbox
GRAPH_POLL_INTERVAL_SECONDS=60
GRAPH_INITIAL_SYNC_DAYS=2
SESSION_TTL_HOURS=10
# The first admin(s); afterwards roles are managed in Admin → Users.
BOOTSTRAP_ADMIN_EMAILS=
LOG_LEVEL=info
# Must stay false in production (the API refuses to start otherwise).
AUTH_DEV_LOGIN=false
